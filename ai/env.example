# backend connection
BACKEND_URL=http://localhost:5000
EDGE_API_KEY=your_edge_api_key_here

# camera settings
CAMERA_ID=cam_01
ZONE_NAME=north_field
CAMERA_SOURCE=0
RTSP_STREAM_URL=rtsp://admin:password@192.168.1.100:554/stream1

# detection threshold & cooldown
CONFIDENCE_THRESHOLD=0.5
COOLDOWN_SECONDS=10
TARGET_ANIMALS=cow,goat,pig,sheep,horse,dog,cat,bear,elephant,zebra,giraffe

# dry run mode (true/false)
DRY_RUN=false
